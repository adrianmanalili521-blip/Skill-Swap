rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isParticipant(data) {
      return isSignedIn() &&
        (request.auth.uid == data.fromUserId || request.auth.uid == data.toUserId);
    }

    // ---------- users/{userId} ----------
    // Public profile info is readable by any signed-in user (needed for
    // browsing skills/listings and seeing who posted them).
    // Only the owner (or an admin) can create/update/delete their own doc.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'user'; // clients can never self-assign admin
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role)
                    || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ---------- skills/{skillId} ----------
    // Skill listings are public read (discovery feed / search).
    // Only the owner can create/edit/delete their own listing; admins can
    // moderate (e.g. take down inappropriate content) via update/delete.
    match /skills/{skillId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner(resource.data.ownerId)
               && request.resource.data.ownerId == resource.data.ownerId)
            || isAdmin();
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ---------- swapRequests/{requestId} ----------
    // Only the two participants (sender/receiver) can read a request.
    // Senders may cancel pending requests; recipients may accept or decline.
    match /swapRequests/{requestId} {
      allow read: if isParticipant(resource.data) || isAdmin();

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll([
                      'fromUserId', 'toUserId', 'skillId', 'offeredSkillId',
                      'message', 'status', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'fromUserId', 'toUserId', 'skillId', 'offeredSkillId',
                      'message', 'status', 'createdAt', 'updatedAt'
                    ])
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.toUserId is string
                    && request.resource.data.toUserId != request.auth.uid
                    && request.resource.data.skillId is string
                    && exists(/databases/$(database)/documents/skills/$(request.resource.data.skillId))
                    && get(/databases/$(database)/documents/skills/$(request.resource.data.skillId)).data.ownerId
                      == request.resource.data.toUserId
                    && get(/databases/$(database)/documents/skills/$(request.resource.data.skillId)).data.status
                      == 'active'
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500
                    && (
                      request.resource.data.offeredSkillId is string
                      || request.resource.data.offeredSkillId == null
                    )
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if (
                      isParticipant(resource.data)
                      && resource.data.status == 'pending'
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'updatedAt'])
                      && request.resource.data.updatedAt is timestamp
                      && (
                        (
                          request.auth.uid == resource.data.toUserId
                          && request.resource.data.status in ['accepted', 'declined']
                        )
                        || (
                          request.auth.uid == resource.data.fromUserId
                          && request.resource.data.status == 'cancelled'
                        )
                      )
                    ) || isAdmin();

      allow delete: if isParticipant(resource.data) || isAdmin();
    }

    // ---------- reviews/{reviewId} ----------
    // Optional: left after a completed swap. Public read, only the author
    // can create, no edits after posting (simplest anti-abuse rule).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
