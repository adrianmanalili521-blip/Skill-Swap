rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active';
    }

    function isParticipant(data) {
      return isSignedIn() &&
        (request.auth.uid == data.fromUserId || request.auth.uid == data.toUserId);
    }

    // ---------- users/{userId} ----------
    // Profile info is readable by active signed-in users (needed for
    // browsing skills/listings and seeing who posted them).
    // Only the owner or an admin can create/update a profile; only admins can delete.
    match /users/{userId} {
      allow read: if isActiveUser() || isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.get('status', 'active') == 'active'; // clients can never self-assign admin or status
      allow update: if (
                      isOwner(userId)
                      && isActiveUser()
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
                    ) || (
                      isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                      && request.resource.data.status in ['active', 'suspended']
                      && request.resource.data.updatedAt is timestamp
                      && (
                        request.resource.data.status == 'active'
                        || (resource.data.role != 'admin' && userId != request.auth.uid)
                      )
                    );
      allow delete: if isAdmin();
    }

    // ---------- skills/{skillId} ----------
    // Active signed-in users can browse skill listings and discovery results.
    // Only the owner can create/edit/delete their own listing; admins can
    // moderate (e.g. take down inappropriate content) via update/delete.
    match /skills/{skillId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isOwner(resource.data.ownerId)
               && isActiveUser()
               && request.resource.data.ownerId == resource.data.ownerId)
            || (
              isAdmin()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && request.resource.data.status in ['active', 'paused', 'removed']
              && request.resource.data.updatedAt is timestamp
            );
      allow delete: if (isOwner(resource.data.ownerId) && isActiveUser()) || isAdmin();
    }

    // ---------- swapRequests/{requestId} ----------
    // Only the two participants (sender/receiver) can read a request.
    // Create: sender must set fromUserId to themself and cannot target self.
    // Update: only participants may change status; sender can cancel,
    // receiver can accept/decline. No changing skillId/participants after creation.
    match /swapRequests/{requestId} {
      allow read: if (isActiveUser() && isParticipant(resource.data) || isAdmin());

      allow create: if isActiveUser()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.toUserId != request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if (isActiveUser()
                        && isParticipant(resource.data) &&
                        request.resource.data.fromUserId == resource.data.fromUserId &&
                        request.resource.data.toUserId == resource.data.toUserId &&
                        request.resource.data.skillId == resource.data.skillId)
                    || isAdmin();

      allow delete: if (isActiveUser() && isParticipant(resource.data)) || isAdmin();
    }

    // ---------- reviews/{reviewId} ----------
    // Optional: left after a completed swap. Public read, only the author
    // can create, no edits after posting (simplest anti-abuse rule).
    match /reviews/{reviewId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if false;
      allow delete: if (isOwner(resource.data.authorId) && isActiveUser()) || isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
